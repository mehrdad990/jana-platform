generator client{provider="prisma-client-js"}datasource db{provider="sqlite" url=env("DATABASE_URL")}
model Project{id String @id @default(cuid()) name String version String @default("0.1.0") stage String @default("Specification") status String @default("active") blockers String @default("[]") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt runs ResearchRun[]}
model ResearchRun{id String @id @default(cuid()) projectId String status String requestJson String resultJson String @default("[]") error String? startedAt DateTime @default(now()) finishedAt DateTime? project Project @relation(fields:[projectId],references:[id],onDelete:Cascade) events Event[] @@index([projectId,startedAt])}
model Event{id String @id @default(cuid()) runId String? name String dataJson String @default("{}") createdAt DateTime @default(now()) run ResearchRun? @relation(fields:[runId],references:[id],onDelete:Cascade) @@index([runId,createdAt])}